# Copy to .env. Never commit .env or paste real credentials into issues.
ZIP_CODE=
SEARCH_RADIUS_MILES=50
# 0 disables radius filtering; missing Apple distance otherwise fails closed.
STORE_NAMES=
CHECK_INTERVAL_SECONDS=60
REPEAT_NOTIFICATION_SECONDS=180
REQUEST_TIMEOUT_SECONDS=20
STARTUP_NOTIFICATION=true
CATALOG_PATH=products.json
STATE_PATH=.state/monitor.state
# Optional locally; REQUIRED for GitHub Actions state caching.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STATE_ENCRYPTION_KEY=
NOTIFY_CHANNELS=bark
BARK_KEY=
BARK_SERVER=https://api.day.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
DISCORD_WEBHOOK_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_SERVER=https://ntfy.sh
